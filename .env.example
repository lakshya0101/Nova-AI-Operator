# NOVA – Personal AI Operating System Configuration
NOVA_ENV=development
NOVA_HOST=127.0.0.1
NOVA_PORT=8000
LOG_LEVEL=INFO

# Persistence
DATABASE_URL=sqlite:///./nova.db
# REDIS_URL=redis://localhost:6379/0

# Nebius Token Factory & NVIDIA Nemotron Models
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_MODEL_LIGHTNING=nvidia/nemotron-mini-4b-instruct
NEBIUS_MODEL_SUPER=nvidia/llama-3.1-nemotron-70b-instruct

# Tavily Web Research
TAVILY_API_KEY=

# MCP Server
MCP_SERVER_NAME=nova
MCP_SERVER_VERSION=2.0.0
MCP_MOUNT_PATH=/mcp
